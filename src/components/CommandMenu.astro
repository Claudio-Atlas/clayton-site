---
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

type Item = { group: string; label: string; hint?: string; href?: string; action?: string; external?: boolean; keywords?: string };
const items: Item[] = [
  ...projects.map((p) => ({ group: 'Projects', label: p.data.name, hint: p.data.category, href: `/work/${p.id}/`, keywords: `${p.data.title} ${p.data.stack.join(' ')}` })),
  { group: 'Go to', label: 'Home', href: '/' },
  { group: 'Go to', label: 'Work', href: '/#work' },
  { group: 'Go to', label: 'Orbital on YouTube', href: '/#youtube', keywords: 'shorts videos' },
  { group: 'Go to', label: 'About', href: '/#about' },
  { group: 'Go to', label: 'Approach', href: '/#approach' },
  { group: 'Go to', label: 'Contact', href: '/#contact', keywords: 'hire email' },
  { group: 'Actions', label: 'Copy email address', hint: 'ragsdale.clay@gmail.com', action: 'copy-email', keywords: 'contact mail' },
  { group: 'Actions', label: 'Send an email', href: 'mailto:ragsdale.clay@gmail.com', external: true },
  { group: 'Links', label: 'YouTube · Orbital', href: 'https://www.youtube.com/@orbital-solver', external: true },
  { group: 'Links', label: 'MAT144.com', href: 'https://www.mat144.com', external: true },
  { group: 'Links', label: 'Onyx Core Enterprises', href: 'https://onyxcoreenterprises.org', external: true },
  { group: 'Links', label: 'LinkedIn', href: 'https://www.linkedin.com/in/clayton-ragsdale/', external: true },
  { group: 'Links', label: 'GitHub', href: 'https://github.com/Claudio-Atlas', external: true },
  { group: 'Links', label: 'Teaching Hub login', href: 'https://hub.claytonragsdale.com', external: true },
];
---

<dialog id="cmdk" class="cmdk m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-transparent" aria-label="Command menu">
  <div data-cmdk-backdrop class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative mx-auto mt-[12vh] w-[min(640px,calc(100vw-32px))] overflow-hidden rounded-2xl border border-white/12 bg-[#0d1017]/95 shadow-2xl shadow-black/70 backdrop-blur-xl">
    <div class="flex items-center gap-3 border-b border-line px-4">
      <span class="text-faint" aria-hidden="true">⌘</span>
      <input
        data-cmdk-input
        type="text"
        placeholder="Search projects, sections, links…"
        class="h-14 flex-1 bg-transparent text-[15px] text-fg outline-none placeholder:text-faint"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="hidden rounded border border-line-strong px-1.5 py-0.5 font-mono text-[10px] text-faint sm:block">esc</kbd>
    </div>
    <ul id="cmdk-list" role="listbox" class="max-h-[min(420px,60vh)] overflow-y-auto p-2" data-lenis-prevent>
      {items.map((it, i) => (
        <li
          role="option"
          id={`cmdk-${i}`}
          data-cmdk-item
          data-group={it.group}
          data-href={it.href}
          data-action={it.action}
          data-external={it.external ? '1' : undefined}
          data-search={`${it.label} ${it.hint ?? ''} ${it.group} ${it.keywords ?? ''}`.toLowerCase()}
          class="flex cursor-pointer items-center justify-between gap-4 rounded-lg px-3 py-2.5 text-sm text-muted aria-selected:bg-white/[0.07] aria-selected:text-fg"
        >
          <span class="flex items-center gap-3">
            <span class="w-16 shrink-0 font-mono text-[10px] uppercase tracking-[0.12em] text-faint">{it.group}</span>
            <span>{it.label}</span>
          </span>
          <span class="truncate font-mono text-[11px] text-faint">{it.hint ?? (it.external ? '↗' : '→')}</span>
        </li>
      ))}
      <li data-cmdk-empty hidden class="px-3 py-6 text-center text-sm text-faint">No matches.</li>
    </ul>
  </div>
</dialog>

<style>
  .cmdk:not([open]) {
    display: none;
  }
  .cmdk[open] {
    animation: cmdk-in 0.25s var(--ease-out-expo);
  }
  @keyframes cmdk-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.99); }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  const dialog = document.getElementById('cmdk') as HTMLDialogElement;
  const input = dialog.querySelector<HTMLInputElement>('[data-cmdk-input]')!;
  const items = Array.from(dialog.querySelectorAll<HTMLElement>('[data-cmdk-item]'));
  const empty = dialog.querySelector<HTMLElement>('[data-cmdk-empty]')!;
  let active = 0;

  const visible = () => items.filter((el) => !el.hidden);
  const select = (i: number) => {
    const list = visible();
    if (!list.length) return;
    active = (i + list.length) % list.length;
    items.forEach((el) => el.setAttribute('aria-selected', 'false'));
    list[active].setAttribute('aria-selected', 'true');
    list[active].scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', list[active].id);
  };
  const filter = () => {
    const q = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    items.forEach((el) => (el.hidden = !q.every((w) => el.dataset.search!.includes(w))));
    empty.hidden = visible().length > 0;
    select(0);
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    filter();
    dialog.showModal();
    window.dispatchEvent(new CustomEvent('menu', { detail: true }));
    input.focus();
  };
  const close = () => {
    if (dialog.open) dialog.close();
  };
  dialog.addEventListener('close', () => window.dispatchEvent(new CustomEvent('menu', { detail: false })));

  const run = async (el: HTMLElement) => {
    const { href, action, external } = el.dataset;
    if (action === 'copy-email') {
      try {
        await navigator.clipboard.writeText('ragsdale.clay@gmail.com');
        el.querySelector('span:last-child')!.textContent = 'Copied ✓';
        setTimeout(close, 700);
      } catch {
        window.location.href = 'mailto:ragsdale.clay@gmail.com';
      }
      return;
    }
    close();
    if (!href) return;
    if (external) window.open(href, href.startsWith('mailto:') ? '_self' : '_blank', 'noopener');
    else navigate(href);
  };

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); const el = visible()[active]; if (el) run(el); }
  });
  items.forEach((el) => {
    el.addEventListener('click', () => run(el));
    el.addEventListener('pointermove', () => select(visible().indexOf(el)));
  });
  dialog.querySelector('[data-cmdk-backdrop]')!.addEventListener('click', close);

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    }
  });
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-cmdk-open]')) open();
  });
</script>
