---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ShortTile from './ShortTile.astro';
import { shorts } from '../data/shorts';
import home from '../assets/work/mat144/home.jpg';
import topics from '../assets/work/mat144/home-topics.jpg';
import review from '../assets/work/mat144/review.jpg';
import videos from '../assets/work/mat144/videos.jpg';
import dq from '../assets/work/mat144/dq.jpg';
import mini from '../assets/work/mat144/mini.jpg';
import mHome from '../assets/work/mat144/m-home.jpg';
import mReview from '../assets/work/mat144/m-review.jpg';
import mVideos from '../assets/work/mat144/m-videos.jpg';
import gSetup from '../assets/work/grader/setup.jpg';
import gRunning from '../assets/work/grader/running.jpg';
import gResults from '../assets/work/grader/results.jpg';
import gReview from '../assets/work/grader/review.jpg';
import aPicker from '../assets/work/axiom/picker.jpg';
import aInserted from '../assets/work/axiom/inserted.jpg';
import aLibrary from '../assets/work/axiom/library.jpg';

interface Props {
  kind: 'orbital' | 'mat144' | 'grader' | 'axiom';
}
const { kind } = Astro.props;

const thumbs = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/work/orbital/*.jpg', { eager: true }),
).map((m) => m.default);

const desktopShots = [
  { src: home, alt: 'mat144.com home page with the course trailer' },
  { src: topics, alt: 'mat144.com course overview' },
  { src: review, alt: 'A step-by-step review question' },
  { src: dq, alt: 'A discussion-question walkthrough' },
  { src: videos, alt: 'The video library' },
  { src: mini, alt: 'Topic 1 mini lessons' },
];
const shotSets = {
  grader: {
    note: 'Screens from the real app, run with a made-up class of 20. No student data.',
    shots: [
      { src: gSetup, alt: 'Drop a ZIP of submissions and pick the assignment' },
      { src: gRunning, alt: 'Live progress while the class is graded' },
      { src: gResults, alt: 'Results, with anything that needs a human look flagged' },
      { src: gReview, alt: 'Review a student: grade sheet beside their workbook formulas' },
    ],
  },
  axiom: {
    note: 'The real extension running on a mock reply page with a made-up student.',
    shots: [
      { src: aPicker, alt: 'Type / and a keyword: the picker narrows 165 responses' },
      { src: aInserted, alt: 'A full, formatted response inserted with the student\u2019s name' },
      { src: aLibrary, alt: 'The library manager: folders, tags, import and export' },
    ],
  },
} as const;

const phoneShots = [
  { src: mHome, alt: 'mat144.com home on a phone' },
  { src: mReview, alt: 'A review question on a phone' },
  { src: mVideos, alt: 'The video library on a phone' },
];
---

{kind === 'orbital' && (
  <section class="site-container pb-20 md:pb-28">
    <p data-reveal class="eyebrow">Watch</p>
    <p data-reveal class="mt-3 max-w-xl text-muted">Made end to end by the pipeline. Hover to preview, or tap to play with sound.</p>
    <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
      {shorts.slice(0, 4).map((sh, i) => (
        <li data-reveal data-delay={String(i * 0.06)}>
          <ShortTile id={sh.id} title={sh.title} views={sh.views} featured={'featured' in sh} />
        </li>
      ))}
    </ul>

    <p data-reveal class="eyebrow mt-20">From the channel</p>
    <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
      {thumbs.slice(0, 12).map((t, i) => (
        <Image data-reveal data-delay={String((i % 4) * 0.05)} src={t} alt="Orbital video thumbnail" widths={[320, 640]} sizes="(min-width: 768px) 280px, 45vw" class="aspect-video w-full rounded-xl border border-line object-cover" loading="lazy" />
      ))}
    </div>
  </section>
)}

{kind === 'mat144' && (
  <section class="site-container pb-20 md:pb-28">
    <p data-reveal class="eyebrow">On a laptop</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {desktopShots.map((s, i) => (
        <figure data-reveal data-delay={String((i % 2) * 0.08)} class="overflow-hidden rounded-2xl border border-line bg-surface">
          <Image src={s.src} alt={s.alt} widths={[640, 1200]} sizes="(min-width: 768px) 570px, 100vw" class="w-full" loading="lazy" />
          <figcaption class="px-4 py-3 font-mono text-[11px] text-faint">{s.alt}</figcaption>
        </figure>
      ))}
    </div>

    <p data-reveal class="eyebrow mt-20">On a phone</p>
    <div class="mt-6 grid grid-cols-3 gap-3 md:gap-6">
      {phoneShots.map((s, i) => (
        <figure data-reveal data-delay={String(i * 0.08)} class="overflow-hidden rounded-[22px] border border-line-strong bg-black p-1.5 md:rounded-[32px] md:p-2">
          <Image src={s.src} alt={s.alt} widths={[300, 600]} sizes="(min-width: 768px) 360px, 30vw" class="w-full rounded-[16px] md:rounded-[24px]" loading="lazy" />
        </figure>
      ))}
    </div>
  </section>
)}

{(kind === 'grader' || kind === 'axiom') && (
  <section class="site-container pb-20 md:pb-28">
    <p data-reveal class="eyebrow">Inside the app</p>
    <p data-reveal class="mt-3 font-mono text-xs text-faint">{shotSets[kind].note}</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {shotSets[kind].shots.map((s, i) => (
        <figure data-reveal data-delay={String((i % 2) * 0.08)} class="overflow-hidden rounded-2xl border border-line bg-surface">
          <Image src={s.src} alt={s.alt} widths={[640, 1200]} sizes="(min-width: 768px) 570px, 100vw" class="w-full" loading="lazy" />
          <figcaption class="px-4 py-3 font-mono text-[11px] text-faint">{s.alt}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

