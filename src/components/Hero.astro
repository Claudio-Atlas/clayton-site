---
import { getCollection } from 'astro:content';
import { SHAPES } from '../scripts/particles';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

// The Orbital mark: Lissajous curve x = sin 2t, y = sin 3t.
const lissajous = Array.from({ length: 121 }, (_, i) => {
  const t = (i / 120) * Math.PI * 2;
  return `${(12 + Math.sin(2 * t) * 8.5).toFixed(2)},${(12 - Math.sin(3 * t) * 8.5).toFixed(2)}`;
}).join(' ');

const lines: { text: string; accent?: boolean }[][] = [
  [{ text: 'Math education,' }],
  [{ text: 'engineered.', accent: true }],
];
---

<section data-hero class="relative isolate flex min-h-[100svh] flex-col overflow-hidden">
  <!-- Particle shapes: Orbital logo → atom → saddle → helix → torus → ripple -->
  <div data-hero-art class="absolute inset-x-0 top-0 h-[62svh] lg:inset-0 lg:h-auto">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_30%,rgb(47_107_255/0.16),transparent_70%)] lg:bg-[radial-gradient(ellipse_40%_50%_at_70%_33%,rgb(47_107_255/0.18),transparent_70%)]"></div>
    <canvas data-particles class="absolute inset-0 h-full w-full cursor-pointer" title="Click to morph" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-0 hidden md:block lg:hidden xl:block" aria-hidden="true">
      {projects.map((p) => (
        <span data-orbit-label class="absolute left-0 top-0 inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-white/15 bg-white/[0.06] px-3 py-1.5 font-mono text-[11px] text-fg/85 backdrop-blur-md will-change-transform">
          <span class="h-1.5 w-1.5 rounded-full bg-[#5b8cff]"></span>{p.data.name}
        </span>
      ))}
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-ink" aria-hidden="true"></div>
  </div>

  <!-- Top-right glass link, like an app badge -->
  <a
    data-reveal
    data-delay="0.9"
    href="https://www.youtube.com/@orbital-solver"
    target="_blank"
    rel="noopener"
    class="glass group absolute right-4 top-20 z-10 hidden items-center gap-3 rounded-2xl p-2.5 pr-4 transition-colors hover:border-white/25 md:right-8 md:top-28 md:flex lg:right-12"
  >
    <span class="grid h-10 w-10 place-items-center rounded-xl bg-black ring-1 ring-[#22c5d8]/40">
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" aria-hidden="true"><polyline points={lissajous} stroke="#22c5d8" stroke-width="1.3" stroke-linejoin="round" /></svg>
    </span>
    <span class="text-xs leading-tight">
      <span class="block font-medium text-fg">350K+ views on YouTube</span>
      <span class="block text-muted">217 lessons · 6,300+ subscribers ↗</span>
    </span>
  </a>

  <div class="site-container pointer-events-none relative z-10 mt-auto pb-8 [&>*]:pointer-events-auto pt-[50svh] md:pb-10 lg:pt-40">
    <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-[#5b8cff]/40 bg-[#2f6bff]/10 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-[#a9c1ff] backdrop-blur">
      <span class="h-1.5 w-1.5 rounded-full bg-[#5b8cff] shadow-[0_0_8px_#5b8cff]"></span>
      Educator · Founder · Builder
    </div>

    <div class="pointer-events-none mt-6 grid items-end gap-8 lg:grid-cols-12 [&>*]:pointer-events-auto">
      <div class="lg:col-span-8">
        <h1 data-split class="display text-[clamp(3rem,min(8.4vw,12svh),7rem)] lg:text-[clamp(3rem,min(7.3vw,12svh),7rem)]">
          {lines.map((line) => (
            <span class="block">
              {line.map((part) =>
                part.text.split(' ').map((w, i, arr) => (
                  <>
                    <span class="word-mask"><span class={part.accent ? 'serif-accent pr-[0.06em] text-[#8fb0ff]' : 'text-gradient'}>{w}</span></span>{i < arr.length - 1 ? ' ' : ''}
                  </>
                )),
              )}
            </span>
          ))}
        </h1>
        <div data-reveal data-delay="0.5" class="mt-7 flex flex-col gap-6 md:flex-row md:items-center md:gap-8">
          <p class="max-w-md text-base leading-relaxed text-muted md:text-[17px]">
            I'm Clayton Ragsdale: math faculty at Grand Canyon University and co-founder of
            <a href="https://onyxcoreenterprises.org" target="_blank" rel="noopener" class="text-fg underline decoration-white/25 underline-offset-4 hover:decoration-white">Onyx Core Enterprises</a>.
            I design and build every product myself, and I'm open to roles, contracts and partnerships.
          </p>
          <div class="flex shrink-0 flex-wrap gap-3">
            <a href="#work" class="btn btn-blue" data-magnetic>See the work <span class="arrow" aria-hidden="true">→</span></a>
            <a href="#contact" class="btn glass !rounded-full text-fg" data-magnetic>Get in touch</a>
          </div>
        </div>
      </div>
      <!-- Interactive particles: collapsed to a pill until opened -->
      <details data-reveal data-delay="0.9" data-shape-panel class="shape-panel group w-full max-w-sm justify-self-start lg:col-span-4 lg:justify-self-end">
        <summary class="glass flex w-fit lg:ml-auto cursor-pointer list-none items-center gap-2.5 rounded-full py-2 pl-3 pr-4 text-sm text-fg transition-colors hover:border-white/25 [&::-webkit-details-marker]:hidden">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"><polyline points={lissajous} stroke="#22c5d8" stroke-width="1.6" stroke-linejoin="round" /></svg>
          Play with the math
          <span class="font-mono text-xs text-faint transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="glass mt-2 rounded-2xl p-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Pick a shape, or click it</p>
          <div class="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Choose a shape">
          {SHAPES.map((name, i) => (
            <button type="button" data-shape={i} aria-pressed={i === 0 ? 'true' : 'false'} class="shape-chip rounded-full border border-white/12 px-3 py-1.5 text-xs text-muted transition-colors hover:text-fg">{name}</button>
          ))}
        </div>
        <form data-fn-form class="mt-3 flex items-center gap-2 rounded-xl border border-white/12 bg-black/30 py-1 pl-3 pr-1 focus-within:border-[#5b8cff]/70">
          <label for="fn-input" class="shrink-0 font-serif text-[15px] italic text-fg/80">z =</label>
          <input id="fn-input" data-fn-input value="sin(x)·cos(y)" spellcheck="false" autocomplete="off" autocapitalize="off" class="min-w-0 flex-1 bg-transparent py-1.5 font-mono text-[13px] text-fg outline-none placeholder:text-faint" placeholder="sin(x)·cos(y)" aria-describedby="fn-msg" />
          <button type="submit" class="shrink-0 rounded-lg bg-[#2f6bff] px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-[#3d78ff]">Draw</button>
        </form>
        <p id="fn-msg" data-fn-msg class="mt-2 min-h-4 font-mono text-[11px] text-faint" aria-live="polite">
          Try:
          {['x^2 - y^2', 'sin(x*y)', 'exp(-(x^2+y^2))', 'cos(sqrt(x^2+y^2)*2)'].map((ex) => (
            <button type="button" data-fn-example={ex} class="tap mx-0.5 text-[#8fb0ff] hover:text-fg">{ex}</button>
          ))}
        </p>
        </div>
      </details>
    </div>

    <!-- Glass project row -->
    <div class="-mx-4 mt-10 overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:px-0 md:mt-12">
      <ol class="grid w-max grid-cols-4 gap-3 sm:w-full">
        {projects.map((p, i) => (
          <li data-reveal data-delay={String(0.7 + i * 0.08)}>
            <a href={`/work/${p.id}/`} class="glass group flex h-full w-[240px] flex-col rounded-2xl p-4 transition-all duration-500 hover:-translate-y-1 hover:border-white/25 sm:w-auto md:p-5">
              <div class="flex items-center justify-between font-mono text-[11px] text-faint">
                <span>{p.data.category}</span>
                <span>0{i + 1}</span>
              </div>
              <p class="mt-6 text-base font-medium text-fg md:mt-8">{p.data.name}</p>
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted">{p.data.title}</p>
              <span class="mt-4 font-mono text-[11px] text-[#8fb0ff] transition-transform duration-500 group-hover:translate-x-1">{p.data.metrics[0].value} · {p.data.metrics[0].label} →</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

