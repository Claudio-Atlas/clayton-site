---
import OrbitalMedia from './media/OrbitalMedia.astro';
import Mat144Media from './media/Mat144Media.astro';
import GraderMedia from './media/GraderMedia.astro';
import AxiomMedia from './media/AxiomMedia.astro';

interface Props {
  kind: 'orbital' | 'mat144' | 'grader' | 'axiom';
}

const { kind } = Astro.props;
---

{kind === 'orbital' && <OrbitalMedia />}
{kind === 'mat144' && <div class="aspect-[16/10] w-full"><Mat144Media /></div>}
{kind === 'grader' && <div class="aspect-[16/10] w-full"><GraderMedia /></div>}
{kind === 'axiom' && <div class="aspect-[16/10] w-full"><AxiomMedia /></div>}
