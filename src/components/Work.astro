---
import { getCollection } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="relative py-24 md:py-36">
  <div class="site-container">
    <div class="mb-14 flex flex-col gap-6 md:mb-20 md:flex-row md:items-end md:justify-between">
      <div>
        <p data-reveal class="eyebrow">Selected work</p>
        <h2 data-reveal data-delay="0.05" class="display mt-5 max-w-2xl text-[clamp(2.2rem,5.5vw,4.25rem)] text-gradient">
          Built in the classroom. <span class="serif-accent text-fg [-webkit-text-fill-color:currentColor]">Used by real students.</span>
        </h2>
      </div>
      <p data-reveal data-delay="0.1" class="max-w-sm text-muted">
        Every project here started as a problem in a course I teach, and every one is in use today.
      </p>
    </div>

    <div data-stack class="space-y-6 lg:space-y-0">
      {projects.map((p, i) => (
        <div class="stack-slot lg:sticky lg:top-0 lg:flex lg:h-screen lg:items-center" style={`--i:${i}`}>
          <article
            data-stack-card
            class="stack-card group relative w-full overflow-hidden rounded-[28px] border border-line-strong bg-surface p-5 sm:p-7 md:rounded-[36px] lg:p-9"
          >
            <div class="pointer-events-none absolute -right-32 -top-32 h-80 w-80 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
            <div data-reveal class="relative grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
              <div class="lg:col-span-5">
                <div class="flex items-center justify-between">
                  <span class="display text-[clamp(3rem,7vw,5.5rem)] leading-none text-fg/10">0{i + 1}</span>
                  <span class="chip">{p.data.category}</span>
                </div>
                <h3 class="display mt-6 text-4xl md:text-5xl">{p.data.name}</h3>
                <p class="mt-2 text-lg text-fg/80">{p.data.title}</p>
                <p class="mt-4 leading-relaxed text-muted">{p.data.tagline}</p>

                <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-line pt-6">
                  {p.data.metrics.map((m) => (
                    <div class="flex flex-col-reverse">
                      <dt class="mt-1 text-xs leading-snug text-faint">{m.label}</dt>
                      <dd class="text-base font-medium tracking-tight text-fg sm:text-lg md:text-xl">{m.value}</dd>
                    </div>
                  ))}
                </dl>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                  <a href={`/work/${p.id}/`} class="btn btn-primary !h-11" data-magnetic>
                    Case study <span class="arrow" aria-hidden="true">→</span>
                  </a>
                  {p.data.links.slice(0, 1).map((l) => (
                    <a href={l.href} target="_blank" rel="noopener" class="btn btn-ghost !h-11">
                      {l.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </div>

              <a href={`/work/${p.id}/`} data-visual class="block lg:col-span-7" tabindex="-1" aria-label={`${p.data.name} case study`}>
                <ProjectVisual kind={p.data.visual} />
              </a>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .stack-card {
      top: calc(var(--i) * 22px + 28px);
      transform-origin: center top;
      box-shadow: 0 -30px 60px -20px rgb(0 0 0 / 0.7);
    }
  }
</style>
