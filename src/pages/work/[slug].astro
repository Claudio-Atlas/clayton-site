---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Layout title={`${d.name}: ${d.title} · Clayton Ragsdale`} description={d.tagline}>
  <article>
    <header class="relative overflow-hidden pb-16 pt-32 md:pb-24 md:pt-44">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="hairline-grid absolute inset-0 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,black,transparent)]"></div>
        <div class="absolute left-1/2 top-[-30%] h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-accent/15 blur-[140px]"></div>
      </div>

      <div class="site-container relative">
        <a href="/#work" data-reveal class="-my-3 inline-flex items-center gap-2 py-3 font-mono text-xs text-muted transition-colors hover:text-fg">
          <span aria-hidden="true">←</span> All work
        </a>
        <p data-reveal data-delay="0.05" class="eyebrow mt-10 flex">{d.category}</p>
        <h1 data-split class="display mt-5 text-[clamp(3rem,10vw,7.5rem)]">
          {d.name.split(' ').map((w, i, arr) => (
            <>
              <span class="word-mask"><span class="text-gradient">{w}</span></span>{i < arr.length - 1 ? ' ' : ''}
            </>
          ))}
        </h1>
        <p data-reveal data-delay="0.3" class="mt-6 max-w-3xl text-xl leading-relaxed text-fg/80 md:text-2xl">
          {d.title}. <span class="text-muted">{d.tagline}</span>
        </p>

        <dl data-reveal data-delay="0.4" class="mt-12 grid gap-8 border-t border-line pt-8 sm:grid-cols-3">
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">Role</dt>
            <dd class="mt-2 text-fg/90">{d.role}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">Stack</dt>
            <dd class="mt-3 flex flex-wrap gap-2">
              {d.stack.map((s) => <span class="chip">{s}</span>)}
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="site-container">
      <div class="spotlight mx-auto rounded-[26px] p-2 md:p-3" transition:name="project-visual">
        <ProjectVisual kind={d.visual} />
      </div>

      <dl class="mt-6 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
        {d.metrics.map((m, i) => (
          <div data-reveal data-delay={String(i * 0.06)} class="flex flex-col-reverse bg-ink p-6 md:p-8">
            <dt class="mt-2 text-sm text-muted">{m.label}</dt>
            <dd class="display text-3xl text-fg md:text-4xl">{m.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="site-container grid gap-12 py-20 md:py-28 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          {d.links.length > 0 && (
            <div class="space-y-3">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">Links</p>
              {d.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="btn btn-ghost w-full justify-between sm:w-auto lg:w-full">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>
      <div data-reveal class="prose-case lg:col-span-8">
        <Content />
      </div>
    </div>

    <Gallery kind={d.visual} />

    <a href={`/work/${next.id}/`} class="group block border-t border-line">
      <div class="site-container flex items-end justify-between gap-6 py-16 md:py-24">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-faint">Next project</p>
          <p class="display mt-4 text-[clamp(2.5rem,7vw,5.5rem)] text-fg/40 transition-colors duration-500 group-hover:text-fg">
            {next.data.name}
          </p>
        </div>
        <span class="mb-4 grid h-14 w-14 shrink-0 place-items-center rounded-full border border-line-strong text-xl transition-all duration-500 group-hover:border-accent group-hover:bg-accent group-hover:text-ink md:h-20 md:w-20" aria-hidden="true">→</span>
      </div>
    </a>
  </article>
</Layout>

<style>
  .prose-case :global(h2) {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 4rem;
    margin-bottom: 1.25rem;
  }
  .prose-case :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-case :global(p) {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .prose-case :global(ul) {
    border-top: 1px solid var(--color-line);
  }
  .prose-case :global(li) {
    position: relative;
    padding: 1.1rem 0 1.1rem 2rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    line-height: 1.7;
  }
  .prose-case :global(li::before) {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 1.85rem;
    width: 8px;
    height: 1px;
    background: var(--color-accent);
  }
  .prose-case :global(strong) {
    color: var(--color-fg);
    font-weight: 500;
  }
  .prose-case :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
</style>
